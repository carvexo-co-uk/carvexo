# Local checkout and email capture
PORT=3000
CARVEXO_DATA_DIR=.data
CARVEXO_MAIL_MODE=capture
CARVEXO_PRODUCTION_APPROVED=false
CARVEXO_ALLOW_INDEXING=false

# Required in Vercel. Use a dedicated Atlas database and database user.
# MONGODB_URI=
# CARVEXO_PUBLIC_ORIGIN=https://carvexo.co.uk
# CARVEXO_TRUST_PROXY_HOPS=1

# Owner login. Generate the hash with scripts/admin-password.mjs.
# CARVEXO_ADMIN_EMAIL=
# CARVEXO_ADMIN_PASSWORD_HASH=
# CARVEXO_ADMIN_SESSION_SECRET=
# CRON_SECRET=

# Stripe sandbox or live. Configure the chosen method in admin after checking its connection.
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# PayPal REST app and webhook, in the same environment.
# PAYPAL_ENVIRONMENT=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=

# Real emails work in both demo and live checkout. Verify the From address with Resend.
# CARVEXO_MAIL_MODE=resend
# RESEND_API_KEY=
# CARVEXO_MAIL_FROM=Carvexo <orders@carvexo.co.uk>
# CARVEXO_OWNER_EMAIL=carvexo.co.uk@gmail.com

# Optional Tawk.to widget
# CARVEXO_TAWK_WIDGET=
